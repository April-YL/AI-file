# Cursor 本地状态与项目配置
# 保留 rules/skills/agents，便于团队共享 Agent 上下文。
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
!.cursor/agents/
!.cursor/agents/**
!.cursor/hooks.json

# Excel 临时/锁文件
~$*

# 系统文件
Thumbs.db
Desktop.ini

# 环境与密钥
.env
.env.*
*.pem

# 日志与依赖（若后续有）
*.log
node_modules/
