# Cursor 本地状态与项目配置
# 保留 rules/skills/agents，便于团队共享 Agent 上下文。
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
!.cursor/agents/
!.cursor/agents/**
!.cursor/hooks.json

# Excel 临时/锁文件
~$*

# 本地生成的质检报告（任意目录）
*_qc_report.json
*_qc_review.html
*_qc_annotated.xlsx
qc_report.json
.tmp_qc_out

# 本地实测/导出目录（不入库；正式回归见 artifacts/case_*）
outputs/*
!outputs/.gitkeep

# 本地临时检查输出（非 fixture）
_summary_check*.txt

# Agent 一次性诊断脚本（应使用 scripts/inspect_*.py 等固定脚本）
scripts/_*.py

# artifacts：仅保留 case_* 回归产物入库，其余为本地临时
artifacts/*
!artifacts/case_*.json
!artifacts/case_*.md

# Python 虚拟环境
.venv/
venv/

# Python 构建产物
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_tmp/
.pytest_tmp*/

# pytest 默认系统临时目录（未指定 basetemp 时）
.tmp/

# IDE / Cursor 本地状态
.idea/
agent-transcripts/

# 本地资料库/案例库（体积大，可能包含脱敏但不适合直接入库的底稿）
固定资产质检agent/资料库/
固定资产质检agent/案例库/

# 系统文件
Thumbs.db
Desktop.ini

# 环境与密钥（仅 .env.example 可入库，见 docs/data-security.md）
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
*.pem

# 日志与依赖（若后续有）
*.log
node_modules/

# Repo hygiene: AI / IDE / Cursor
.cursor/
.vscode/

# Repo hygiene: Python cache
__pycache__/
*.pyc
.pytest_cache/

# Repo hygiene: test artifacts
*.log

# Repo hygiene: runtime outputs
artifacts/
outputs/

# Repo hygiene: AI-generated docs drafts
docs/cursor-transcript-index.html
docs/history/
docs/reports/
docs/planning/*.xlsx

# Repo hygiene: OS
.DS_Store

# Repo hygiene: Excel / local datasets (IMPORTANT)
*.xlsx
*.xls
资料库/
固定资产质检agent/资料库/
固定资产质检agent/质检测试结果/
