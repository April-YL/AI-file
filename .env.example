# 固定资产质检 Agent — 大模型 API 模板（可复制为 .env）
# 安全：本文件可提交 Git；真实 FA_QC_LLM_API_KEY 只写在 .env（已在 .gitignore）。
# 见 docs/data-security.md
# OpenAI 兼容 chat/completions；UI 勾选「大模型增强」或 fa-qc-run --llm 时使用。

# 总开关（UI 勾选时会覆盖为 true；命令行也可用 --llm）
FA_QC_LLM_ENABLED=false

# Local run history and deliverables (SQLite + JSON/HTML/annotated workbook).
# Keep this directory outside Git tracking because it may contain client data.
FA_QC_DATA_DIR=E:\AI file\local_data\fixed_asset_qc

# ---------- 按你的服务商填写（仅保留一组，其余可删或注释）----------

# OpenAI 官方
# FA_QC_LLM_BASE_URL=https://api.openai.com/v1
# FA_QC_LLM_MODEL=gpt-4o-mini

# DeepSeek
# FA_QC_LLM_BASE_URL=https://api.deepseek.com/v1
# FA_QC_LLM_MODEL=deepseek-chat

# Moonshot / Kimi
# FA_QC_LLM_BASE_URL=https://api.moonshot.cn/v1
# FA_QC_LLM_MODEL=moonshot-v1-8k

# Azure OpenAI（BASE_URL 填部署端点，MODEL 填部署名）
# FA_QC_LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
# FA_QC_LLM_MODEL=YOUR-DEPLOYMENT

# 本地 Ollama（密钥可填 ollama 或任意非空字符串）
# FA_QC_LLM_BASE_URL=http://127.0.0.1:11434/v1
# FA_QC_LLM_MODEL=qwen2.5:7b

# 自建 / 其他 OpenAI 兼容网关（默认占位，请改成你的地址与模型 ID）
FA_QC_LLM_BASE_URL=https://your-api-host/v1
FA_QC_LLM_MODEL=your-model-id

# 必填：API Key（勿写入 Git）
FA_QC_LLM_API_KEY=

# 可选
FA_QC_LLM_TIMEOUT=120
FA_QC_LLM_MAX_TOKENS=4096

# 网络稳定性（可选）
# 临时网络错误、超时、429/502/503/504 会重试；401/403 等配置错误不重试。
FA_QC_LLM_MAX_RETRIES=2
FA_QC_LLM_RETRY_BACKOFF=1.5

# 代理设置（可选）
# 如果公司网络需要代理，可直接填代理地址；不填时默认读取系统 HTTP_PROXY/HTTPS_PROXY。
# FA_QC_LLM_PROXY=http://127.0.0.1:7890
FA_QC_LLM_TRUST_ENV=true
